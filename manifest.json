{
  "manifest_version": 3,
  "name": "Tab Freezer",
  "description": "Freeze inactive pages and resume them when selected.",
  "version": "1.0.0",
  "minimum_chrome_version": "132",
  "permissions": ["alarms", "debugger", "storage", "tabs", "webNavigation"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
